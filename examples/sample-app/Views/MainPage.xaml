<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleApp.Views.MainPage"
             Title="Home">
    <Grid Padding="24" RowSpacing="16" RowDefinitions="Auto,Auto,Auto">

        <Label Grid.Row="1"
               Text="Welcome back!"
               FontSize="24"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Grid.Row="0"
               Text="Open the menu to reach Settings, or log out below."
               FontSize="14" />

        <Button Grid.Row="2"
                Text="Log Out"
                Clicked="OnLogoutClicked"
                HorizontalOptions="Start"
                SemanticProperties.Hint="Signs you out of the app" />

    </Grid>
</ContentPage>
