<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SampleApp.Resources.Localization"
             x:Class="SampleApp.Views.SettingsPage"
             Title="Settings">
    <VerticalStackLayout Padding="24" Spacing="16">

        <Label Text="Account"
               FontSize="20"
               SemanticProperties.HeadingLevel="Level1" />

        <Button Text="Profile"
                Clicked="OnProfileTapped"
                HorizontalOptions="Fill"
                SemanticProperties.Description="Navigate to account settings" />

        <Label Text="Preferences"
               FontSize="20"
               SemanticProperties.HeadingLevel="Level1" />

        <Image Source="notification_bell.png"
               SemanticProperties.Description="{strings:Localize A11y_NotificationIcon_Description}" />

        <Label Text="Volume" />
        <Slider x:Name="VolumeSlider"
                Value="{Binding Volume}"
                SemanticProperties.Description="{strings:Localize A11y_VolumeSlider_Description}" />

        <Label x:Name="LanguageLabel" Text="Language" />
        <Picker x:Name="LanguagePicker"
                Title="Language"
                ItemsSource="{Binding Languages}" />

    </VerticalStackLayout>
</ContentPage>
