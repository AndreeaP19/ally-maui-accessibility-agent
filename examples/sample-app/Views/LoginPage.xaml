<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:SampleApp.Resources.Localization"
             x:Class="SampleApp.Views.LoginPage"
             Title="Login">
    <VerticalStackLayout Padding="24" Spacing="16">

        <ImageButton Source="back_arrow.png"
                     Clicked="OnBackTapped"
                     HorizontalOptions="Start"
                     SemanticProperties.Description="Back" />

        <Label Text="Welcome back"
               FontSize="24"
               SemanticProperties.HeadingLevel="Level1" />

        <Entry x:Name="EmailEntry"
               Placeholder="Email" />

        <Entry x:Name="PasswordEntry"
               Placeholder="Password"
               IsPassword="True" />

        <HorizontalStackLayout Spacing="8">
            <CheckBox x:Name="RememberMeCheck"
                      SemanticProperties.Description="Remember me" />
            <Label Text="Remember me" />
        </HorizontalStackLayout>

        <Button Text="Log In"
                Clicked="OnLoginClicked"
                SemanticProperties.Hint="Submit the login form and navigate to the dashboard" />

        <Button Text="Forgot Password?"
                Clicked="OnForgotPasswordTapped"
                SemanticProperties.Hint="Forgot Password?: send a password reset link to your email" />

    </VerticalStackLayout>
</ContentPage>
