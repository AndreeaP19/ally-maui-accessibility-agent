<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleApp.Views.ProfilePage"
             Title="Profile">
    <VerticalStackLayout Padding="24" Spacing="16">

        <Image WidthRequest="80"
               HeightRequest="80"
               HorizontalOptions="Center">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAvatarTapped" />
            </Image.GestureRecognizers>
            <Image.Source>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe853;" />
            </Image.Source>
        </Image>

        <Image Source="verified_badge.png"
               WidthRequest="20"
               HeightRequest="20"
               HorizontalOptions="Center" />

        <Label Text="Account Details"
               FontSize="20"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1" />

        <Label Text="Phone" FontSize="12" />
        <Entry x:Name="PhoneEntry" Placeholder="Phone number" />

        <Label Text="Subscription"
               FontSize="20"
               FontAttributes="Bold" />

        <Frame x:Name="PlanCard" BorderColor="#DDDDDD" CornerRadius="8" Padding="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Pro Plan" FontAttributes="Bold" />
                <Button Text="Manage" Clicked="OnManagePlanClicked" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>
